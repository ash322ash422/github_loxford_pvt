    <nodes>
      <node id="MERIDIAN HEALTH SYSTEMS" label="MERIDIAN HEALTH SYSTEMS">
        <attvalues>
          <attvalue for="0" value="ORGANIZATION: Meridian Health Systems is a hospital network based in Austin, Texas that has partnered to deploy surgical assistance robots across its twelve facilities." />
          <attvalue for="1" value="-1" />
          <attvalue for="2" value="12" />
        </attvalues>
      </node>
      <node id="NOVACARE ROBOTICS" label="NOVACARE ROBOTICS">
        <attvalues>
          <attvalue for="0" value="ORGANIZATION: NovaCare Robotics is a company founded in 2018 that supplies robotic systems to healthcare facilities, known for its surgical assistance robots." />
          <attvalue for="1" value="-1" />
          <attvalue for="2" value="12" />
        </attvalues>
      </node>
      <node id="DR. AMARA OSEI" label="DR. AMARA OSEI">
        <attvalues>
          <attvalue for="0" value="PERSON: Dr. Amara Osei is the Chief Innovation Officer at Meridian Health Systems, previously involved in a robotics initiative at Cedar Ridge Medical." />
          <attvalue for="1" value="-1" />
          <attvalue for="2" value="12" />
        </attvalues>
      </node>
      <node id="WEI ZHANG" label="WEI ZHANG">
        <attvalues>
          <attvalue for="0" value="PERSON: Wei Zhang is the engineer who founded NovaCare Robotics and has contributed significantly to robotic surgery technology." />
          <attvalue for="1" value="-1" />
          <attvalue for="2" value="12" />
        </attvalues>
      </node>
      <node id="TEXAS NURSES COALITION" label="TEXAS NURSES COALITION">
        <attvalues>
          <attvalue for="0" value="ORGANIZATION: The Texas Nurses Coalition is a group that raised concerns about the implications of robotic surgery, particularly regarding job displacement and patient safety." />
          <attvalue for="1" value="-1" />
          <attvalue for="2" value="12" />
        </attvalues>
      </node>
      <node id="CEDAR RIDGE MEDICAL" label="CEDAR RIDGE MEDICAL">
        <attvalues>
          <attvalue for="0" value="ORGANIZATION: Cedar Ridge Medical is a hospital that signed a robotics agreement with NovaCare Robotics and was Dr. Osei's former employer." />
          <attvalue for="1" value="-1" />
          <attvalue for="2" value="12" />
        </attvalues>
      </node>
      <node id="NATIONAL HEALTHCARE INNOVATION SUMMIT" label="NATIONAL HEALTHCARE INNOVATION SUMMIT">
        <attvalues>
          <attvalue for="0" value="EVENT: The National Healthcare Innovation Summit is an event in Chicago where innovations in healthcare technology are discussed and showcased, including contributions from Wei Zhang." />
          <attvalue for="1" value="-1" />
          <attvalue for="2" value="12" />
        </attvalues>
      </node>
      <node id="AUSTIN" label="AUSTIN">
        <attvalues>
          <attvalue for="0" value="GEO: Austin is the city in Texas where Meridian Health Systems is located and where public hearings regarding robotic surgery took place." />
          <attvalue for="1" value="-1" />
          <attvalue for="2" value="12" />
        </attvalues>
      </node>
      <node id="2024" label="2024">
        <attvalues>
          <attvalue for="0" value="EVENT: March 2024 is when Meridian Health Systems announced its partnership with NovaCare Robotics." />
          <attvalue for="1" value="-1" />
          <attvalue for="2" value="12" />
        </attvalues>
      </node>
      <node id="2025" label="2025">
        <attvalues>
          <attvalue for="0" value="EVENT: By the end of 2025, NovaCare Robotics emerged as a leading supplier and Meridian noted improvements in surgery times." />
          <attvalue for="1" value="-1" />
          <attvalue for="2" value="12" />
        </attvalues>
      </node>
    </nodes>
