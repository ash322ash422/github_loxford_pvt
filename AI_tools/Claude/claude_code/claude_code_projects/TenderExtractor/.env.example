# Copy this file to .env and fill in real values.
# The app runs with local fallbacks for anything left blank,
# EXCEPT Azure OpenAI, which is required for field extraction.

ENV=poc

# --- Pipeline behaviour ---
MISC_PAGES_PER_CHUNK=20     # terms/makes/documents extraction batch size (tender_extraction_service.py)
MAX_UPLOAD_SIZE_MB=10       # POST /tenders rejects anything larger with 413
NOTIFY_ON_COMPLETE=false    # set true + fill in NOTIFY_RECIPIENT to email on success
NOTIFY_RECIPIENT=

# --- Tender pre-check + page usage quota ---
# How many leading pages get OCR'd for the tender keyword check
# (Notice/Tender/NIT) and fed to the index-extraction LLM call.
INDEX_CHECK_PAGES=3
# Shared monthly OCR page budget across all jobs. POST /tenders returns 429
# once this month's usage is already at/over the limit; also reported in
# every tender's "Page Usage Report" Excel sheet.
MAX_PAGES_PER_MONTH=10000

# --- Per-job file retention (scripts/cleanup_old_jobs.py) ---
# Days after a job completes before its data_uploads/{job_id}/,
# output/{job_id}/, logs/{job_id}/ are deleted. job_flow_status.db rows
# are never touched by it.
UPLOAD_RETENTION_DAYS=7
OUTPUT_LOGS_RETENTION_DAYS=30

# --- API (app/api/main.py) ---
# Origins allowed to call the API cross-origin, e.g. a React dev server
# or Streamlit app running on a different port. Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# --- API auth (POST /login) ---
# Accounts live in local_state/users.db (bcrypt-hashed passwords), managed
# through the /users* endpoints or the frontend's "Manage users" admin
# section - NOT through this file. AUTH_USERNAME/AUTH_PASSWORD are only
# the bootstrap seed for the first admin account, used once when that
# table is still empty; editing them later has no effect on an existing
# deployment. Blank AUTH_PASSWORD with an empty table means nobody can
# ever log in (fails closed, not open).
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a random key is generated at process startup instead -
# fine for local dev, but every login token breaks on the next restart.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend (frontend/streamlit_app.py) ---
# Where the Streamlit app should find the API above.
TENDEREXTRACTOR_API_URL=http://127.0.0.1:8000

# --- Azure Blob Storage (optional - falls back to local disk / logging) ---
# Holds each run's finished Excel AND a copy of job_flow_status.db, pushed
# here after every pipeline run (see job_db_backup.py). If unset, the
# pipeline just logs the current job records instead of failing.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_OUTPUT=automation-file-processed
URL_EXPIRY_HOURS=24

# --- Azure AI Document Intelligence (required for OCR) ---
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
AZURE_DOCINTEL_MODEL=prebuilt-layout

# --- Azure OpenAI (required for field extraction) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# --- Email notifications (optional - pick one provider) ---
AZURE_EMAIL_COMMUNICATIONS_STRING=
AZURE_EMAIL_SENDER=
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
