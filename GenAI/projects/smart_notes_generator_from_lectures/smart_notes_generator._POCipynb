  {
   "cell_type": "markdown",
   "id": "e2b925e2",
   "metadata": {},
   "source": [
    "## 5. Map-reduce pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "709c6d0b",
   "metadata": {},
   "outputs": [],
   "source": [
    "system_prompt_map = \"\"\"\n",
    "You extract structured study notes from a segment of a lecture transcript.\n",
    "Use only information present in the segment. Be concise. Ignore filler and off-topic chatter.\n",
    "\"\"\"\n",
    "\n",
    "human_prompt_map = \"\"\"\n",
    "Transcript segment:\n",
    "----\n",
    "{chunk}\n",
    "----\n",
    "\"\"\"\n",
    "\n",
    "MAP_PROMPT = ChatPromptTemplate.from_messages([\n",
    "    (\"system\",system_prompt_map ),\n",
    "    (\"human\", human_prompt_map),\n",
    "])\n",
    "\n",
    "REDUCE_PROMPT = ChatPromptTemplate.from_messages([\n",
    "    (\"system\",\n",
    "     \"You merge partial lecture notes (in order) into one coherent set of study notes. \"\n",
    "     \"Merge duplicate sections and terms, keep logical order, and do not invent facts. \"\n",
    "     \"Generate a title, summary, review questions and action items from the content.\"),\n",
    "    \n",
    "    (\"human\", \"Partial notes (JSON):\\n\\n{partials}\"),\n",
    "])\n",
    "\n",
    "def generate_notes(text: str, llm, chunk_size: int = 6000, overlap: int = 300, concurrency: int = 4) -> LectureNotes:\n",
    "    splitter = RecursiveCharacterTextSplitter(chunk_size=chunk_size, chunk_overlap=overlap)\n",
    "    chunks = splitter.split_text(text)\n",
    "    if not chunks:\n",
    "        raise ValueError(\"Empty input text.\")\n",
    "\n",
    "    map_chain = MAP_PROMPT | llm.with_structured_output(ChunkNotes)\n",
    "    partials: List[ChunkNotes] = map_chain.batch(\n",
    "        [{\"chunk\": c} for c in chunks], config={\"max_concurrency\": concurrency}\n",
    "    )\n",
    "\n",
    "    payload = json.dumps([p.model_dump() for p in partials], ensure_ascii=False)\n",
    "    reduce_chain = REDUCE_PROMPT | llm.with_structured_output(LectureNotes)\n",
    "    return reduce_chain.invoke({\"partials\": payload})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8f18a7ad-82d2-4d8f-9261-8dfec3db1c7f",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "markdown",
   "id": "ba929752",
   "metadata": {},
   "source": [
    "## 6. Render & export"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "cc377e43",
   "metadata": {},
   "outputs": [],
   "source": [
    "def to_markdown(n: LectureNotes) -> str:\n",
    "    out = [f\"# {n.title}\", \"\", \"## Summary\", n.summary, \"\"]\n",
    "    for s in n.sections:\n",
    "        out += [f\"## {s.heading}\"] + [f\"- {p}\" for p in s.key_points]\n",
    "        if s.examples:\n",
    "            out += [\"\", \"**Examples**\"] + [f\"- {e}\" for e in s.examples]\n",
    "        out.append(\"\")\n",
    "    if n.key_terms:\n",
    "        out += [\"## Key Terms\"] + [f\"- **{k.term}**: {k.definition}\" for k in n.key_terms] + [\"\"]\n",
    "    if n.review_questions:\n",
    "        out += [\"## Review Questions\"] + [f\"{i}. {q}\" for i, q in enumerate(n.review_questions, 1)] + [\"\"]\n",
    "    if n.action_items:\n",
    "        out += [\"## Action Items\"] + [f\"- [ ] {a}\" for a in n.action_items]\n",
    "    return \"\\n\".join(out).strip()\n",
    "\n",
    "def save_markdown(md_text: str, path: str = \"notes.md\") -> str:\n",
    "    Path(path).write_text(md_text, encoding=\"utf-8\")\n",
    "    return path"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "35c2556e-3ea1-4b64-b792-3f97f7e3c2ca",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "markdown",
