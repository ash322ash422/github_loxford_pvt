   "source": [
    "import os, json, getpass, textwrap\n",
    "from pathlib import Path\n",
    "from typing  import List\n",
    "\n",
    "# import torch\n",
    "from pydantic                 import BaseModel, Field\n",
    "from pypdf                    import PdfReader\n",
    "from langchain_text_splitters import RecursiveCharacterTextSplitter\n",
    "from langchain_core.prompts   import ChatPromptTemplate\n",
    "from langchain_openai         import ChatOpenAI\n",
    "from langchain_google_genai   import ChatGoogleGenerativeAI"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5325643f-16af-4d0d-94d9-0c30e39e6602",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "markdown",
   "id": "6654879e",
   "metadata": {},
   "source": [
    "## 2. Config & LLM factory"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "bf9d1220",
   "metadata": {},
   "outputs": [],
   "source": [
    "DEFAULT_MODELS = {\n",
    "    \"openai\": \"gpt-4o-mini\",\n",
    "    \"gemini\": \"gemini-2.5-flash\",\n",
    "}\n",
    "ENV_KEYS = {\"openai\": \"OPENAI_API_KEY\", \"gemini\": \"GOOGLE_API_KEY\"}\n",
    "\n",
    "def get_llm(provider: str, model: str | None = None, api_key: str | None = None, temperature: float = 0.2):\n",
    "    provider = provider.lower()\n",
    "    if provider not in DEFAULT_MODELS:\n",
    "        raise ValueError(f\"provider must be one of {list(DEFAULT_MODELS)}\")\n",
    "    model = model or DEFAULT_MODELS[provider]\n",
    "    key = api_key or os.getenv(ENV_KEYS[provider]) or getpass.getpass(f\"{ENV_KEYS[provider]}: \")\n",
    "    if provider == \"openai\":\n",
    "        return ChatOpenAI(model=model, api_key=key, temperature=temperature)\n",
    "    return ChatGoogleGenerativeAI(model=model, google_api_key=key, temperature=temperature)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d1868195-afc8-47c9-882f-b3c7eb1eabe1",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "markdown",
   "id": "73da9603",
   "metadata": {},
   "source": [
    "## 3. Output schemas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "622234e0",
   "metadata": {},
   "outputs": [],
   "source": [
    "class Section(BaseModel):\n",
    "    heading: str = Field(description=\"Short topic heading\")\n",
    "    key_points: List[str] = Field(description=\"Concise bullet points covering the topic\")\n",
    "    examples: List[str] = Field(description=\"Examples or analogies given in the lecture; empty if none\")\n",
    "\n",
    "class KeyTerm(BaseModel):\n",
    "    term: str\n",
    "    definition: str\n",
    "\n",
    "class ChunkNotes(BaseModel):\n",
    "    sections: List[Section]\n",
    "    key_terms: List[KeyTerm]\n",
    "\n",
    "class LectureNotes(BaseModel):\n",
    "    title: str\n",
    "    summary: str = Field(description=\"3-5 sentence overview\")\n",
    "    sections: List[Section]\n",
    "    key_terms: List[KeyTerm]\n",
    "    review_questions: List[str] = Field(description=\"5-8 questions to test understanding\")\n",
    "    action_items: List[str] = Field(description=\"Homework, readings, deadlines mentioned; empty if none\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7e37103d-1fbd-45a0-867a-c1f18bb041b3",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "markdown",
   "id": "055623a8",
   "metadata": {},
   "source": [
    "## 4. Input loaders (text, PDF, audio)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "ada68bf4",
   "metadata": {},
   "outputs": [],
   "source": [
    "_asr = None\n",
    "\n",
    "# Following takes input name of file path and the model_id and returns the transcribed text\n",
    "# Model openai/whisper-small is almost 1.6GB\n",
    "def transcribe_audio(path: str, model_id: str = \"openai/whisper-small\") -> str:\n",
    "    global _asr\n",
    "    if _asr is None:\n",
    "        from transformers import pipeline\n",
    "        import torch\n",
    "        \n",
    "        _asr = pipeline(\n",
    "            \"automatic-speech-recognition\",\n",
    "            model=model_id,\n",
    "            chunk_length_s=30,\n",
    "            device=0 if torch.cuda.is_available() else -1,\n",
    "        )\n",
    "    return _asr(path)[\"text\"].strip()\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "def load_text(path: str) -> str:\n",
    "    p = Path(path)\n",
    "    ext = p.suffix.lower()\n",
    "    \n",
    "    if ext in {\".txt\", \".md\", \".srt\", \".vtt\"}:\n",
    "        return p.read_text(encoding=\"utf-8\", errors=\"ignore\")\n",
    "        \n",
    "    if ext == \".pdf\":\n",
    "        return \"\\n\".join((pg.extract_text() or \"\") for pg in PdfReader(str(p)).pages)\n",
    "    \n",
    "    if ext in {\".mp3\", \".wav\", \".m4a\", \".flac\", \".ogg\", \".mp4\", \".webm\"}:\n",
    "        return transcribe_audio(str(p))\n",
    "    \n",
    "    raise ValueError(f\"Unsupported file type: {ext}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6295e1c5-7d0a-4c04-b1fc-6f5f38373011",
