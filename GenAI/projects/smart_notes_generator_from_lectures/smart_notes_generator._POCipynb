   "source": [
    "import gradio as gr\n",
    "\n",
    "def run_ui(file, pasted_text, provider, model, api_key, chunk_size, progress=gr.Progress()):\n",
    "    try:\n",
    "        progress(0.1, desc=\"Loading input\")\n",
    "        text = load_text(file) if file else (pasted_text or \"\")\n",
    "        if not text.strip():\n",
    "            return \"No input provided.\", None\n",
    "        progress(0.4, desc=\"Generating notes\")\n",
    "        llm = get_llm(provider, model.strip() or None, api_key.strip() or None)\n",
    "        notes = generate_notes(text, llm, chunk_size=int(chunk_size))\n",
    "        md_text = to_markdown(notes)\n",
    "        return md_text, save_markdown(md_text)\n",
    "    except Exception as e:\n",
    "        return f\"**Error:** {e}\", None\n",
    "\n",
    "with gr.Blocks(title=\"Smart Notes Generator\") as demo:\n",
    "    gr.Markdown(\"# Smart Notes Generator\")\n",
    "    with gr.Row():\n",
    "        with gr.Column():\n",
    "            file = gr.File(label=\"Audio / PDF / text file\", type=\"filepath\")\n",
    "            pasted = gr.Textbox(label=\"...or paste transcript\", lines=8)\n",
    "            provider = gr.Dropdown([\"openai\", \"gemini\"], value=\"openai\", label=\"Provider\")\n",
    "            model = gr.Textbox(label=\"Model (blank = default)\", placeholder=\"gpt-4o-mini / gemini-2.5-flash\")\n",
    "            key = gr.Textbox(label=\"API key (blank = use env var)\", type=\"password\")\n",
    "            chunk = gr.Slider(2000, 12000, value=6000, step=500, label=\"Chunk size (chars)\")\n",
    "            btn = gr.Button(\"Generate\", variant=\"primary\")\n",
    "        with gr.Column():\n",
    "            out = gr.Markdown()\n",
    "            dl = gr.File(label=\"Download notes.md\")\n",
    "    btn.click(run_ui, [file, pasted, provider, model, key, chunk], [out, dl])\n",
    "\n",
    "demo.launch()"
   ]
  },
